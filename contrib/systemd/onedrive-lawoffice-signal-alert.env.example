# Copy to /etc/default/onedrive-lawoffice-signal-alert and fill in the destination.

# Local Signal REST API wrapper.
SIGNAL_API_BASE=http://127.0.0.1:9080

# Source number registered with signal-api.
# Example: SIGNAL_SOURCE_NUMBER=+14132961110
SIGNAL_SOURCE_NUMBER=

# Comma-separated Signal recipients or group IDs.
# Example: SIGNAL_RECIPIENTS=+15551234567
# Example: SIGNAL_RECIPIENTS=group.ckRzaEd4VmRzNnJaASAEsasa
SIGNAL_RECIPIENTS=

# Re-notify interval for unchanged alerts, in seconds.
RENOTIFY_SECONDS=21600

# Send a one-time recovery message when the service returns to OK.
NOTIFY_ON_RECOVERY=true